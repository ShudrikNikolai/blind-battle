NODE_ENV=production
TZ=Europe/Moscow

ALLOWED_ORIGIN=http://localhost:8080
CREDENTIALS=true

SECRET=change-me-to-a-long-random-string
MAX_AGE=36000

# Первый админ создаётся при старте, если такого логина ещё нет.
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=change-me-now
# Одноразово: true принудительно применит env-пароль к существующему админу.
DEFAULT_ADMIN_RESET_PASSWORD=false

APP_NAME=blind-battle
APP_PORT=3000
APP_BASE_URL=http://localhost:8080
APP_LOCALE=ru
APP_GLOBAL_PREFIX=api
APP_GLOBAL_DEFAULT_API_VERSION=1

# Для продакшена выставить false: Angie всё равно закрывает /api/swagger.
SWAGGER_ENABLE=true
SWAGGER_CREATE_FILE=false
SWAGGER_PATH=api/swagger

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app_user
DB_PASSWORD=app_password
DB_DATABASE=blind_battle
DB_SYNCHRONIZE=false

BULLMQ_HOST=localhost
BULLMQ_PORT=6379

TOKEN=123456789:AAExampleTokenFromBotFather
ADMINS_IDS=111111111,222222222

# polling — dev, webhook — prod (требует https APP_BASE_URL).
TELEGRAM_MODE=polling
# Только для webhook: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
