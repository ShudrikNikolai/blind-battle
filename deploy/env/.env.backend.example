NODE_ENV=production
TZ=Europe/Moscow

ALLOWED_ORIGIN=http://localhost:8080
CREDENTIALS=true

SECRET=change-me-to-a-long-random-string
MAX_AGE=36000

APP_NAME=blind-battle
APP_PORT=3000
APP_BASE_URL=http://localhost:8080
APP_LOCALE=ru
APP_GLOBAL_PREFIX=api
APP_GLOBAL_DEFAULT_API_VERSION=1

SWAGGER_ENABLE=true
SWAGGER_CREATE_FILE=false
SWAGGER_PATH=api/swagger

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app_user
DB_PASSWORD=app_password
DB_DATABASE=blind_battle
DB_SYNCHRONIZE=false

BULLMQ_HOST=localhost
BULLMQ_PORT=6379

TOKEN=123456789:AAExampleTokenFromBotFather
ADMINS_IDS=111111111_222222222
