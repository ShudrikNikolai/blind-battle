NODE_ENV=dev
TZ=Europe/Moscow

ALLOWED_ORIGIN='http://localhost:3000'
CREDENTIALS=true

SECRET=change-me-to-a-long-random-string
MAX_AGE=36000

DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=admin12345

APP_NAME='blind-battle'
APP_PORT=3000
APP_BASE_URL='http://localhost:3000'
APP_LOCALE='ru'
APP_GLOBAL_PREFIX='api'
APP_GLOBAL_DEFAULT_API_VERSION='1'

SWAGGER_ENABLE=true
SWAGGER_CREATE_FILE=false

SWAGGER_PATH='api/swagger'

DB_HOST='localhost'
DB_PORT=5432
DB_USERNAME='app_user'
DB_PASSWORD='app_password'
DB_DATABASE='blind_battle'
DB_SYNCHRONIZE=false

BULLMQ_HOST='localhost'
BULLMQ_PORT=6379

# polling — dev, webhook — prod.
TELEGRAM_MODE=polling
# Только для webhook: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

ADMINS_IDS=111111111,222222222
TOKEN=
